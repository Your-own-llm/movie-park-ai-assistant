# Agent orchestration
AGENT_PROVIDER=local
# Set to crewai when CREWAI_SERVICE_URL points to a deployed CrewAI service.
# AGENT_PROVIDER=crewai
# CREWAI_SERVICE_URL=https://your-crewai-service.example.com

# Real AI intake
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional portfolio/RAG
# PORTFOLIO_PROVIDER=anythingllm
# ANYTHINGLLM_URL=
# ANYTHINGLLM_WORKSPACE=
# ANYTHINGLLM_API_KEY=

# Optional public research
# FIRECRAWL_API_KEY=
# FIRECRAWL_URL=

# Optional notifications
# HANDOFF_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=

# Production admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_OUTPUT_FROM_NPM_RUN_ADMIN_HASH
ADMIN_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Production database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set DATABASE_SSL=false only for a trusted local Postgres instance.
DATABASE_SSL=true

# Local fallback when DATABASE_URL is absent
DATABASE_PATH=./movie-park-inquiries.json
